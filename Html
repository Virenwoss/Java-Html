<!DOCTYPE html>
<html>

<head>

    <title>Vehicle Rental System</title>

    <style>

        /* ---------- PAGE DESIGN ---------- */

        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 0;
            padding: 20px;
        }

        .container {
            width: 80%;
            margin: auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
        }

        h1 {
            text-align: center;
        }

        h2 {
            margin-top: 0;
        }


        /* ---------- MENU ---------- */

        .menu {
            text-align: center;
            margin: 20px 0;
        }

        button {
            background-color: #333;
            color: white;
            border: none;
            padding: 10px 15px;
            margin: 5px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #555;
        }


        /* ---------- SECTIONS ---------- */

        .section {
            display: none;
            border: 1px solid #ddd;
            padding: 20px;
            margin-top: 15px;
            border-radius: 5px;
        }


        /* ---------- INPUTS ---------- */

        input {
            display: block;
            width: 90%;
            padding: 10px;
            margin: 10px 0;
        }


        /* ---------- VEHICLE ---------- */

        .vehicle {
            border: 1px solid #ccc;
            padding: 15px;
            margin: 10px 0;
            border-radius: 5px;
        }


        /* ---------- REVENUE ---------- */

        .revenue {
            margin-top: 20px;
            padding: 15px;
            background-color: #eee;
            text-align: center;
        }

    </style>

</head>


<body>


<div class="container">

    <h1>VEHICLE RENTAL SYSTEM</h1>


    <!-- MENU -->

    <div class="menu">

        <button onclick="showSection('vehicleSection')">
            Add Vehicle
        </button>

        <button onclick="showSection('customerSection')">
            Add Customer
        </button>

        <button onclick="showSection('displaySection')">
            Available Vehicles
        </button>

        <button onclick="showSection('rentSection')">
            Rent Vehicle
        </button>

        <button onclick="showSection('returnSection')">
            Return Vehicle
        </button>

        <button onclick="showSection('historySection')">
            Rental History
        </button>

    </div>



    <!-- ================= ADD VEHICLE ================= -->

    <div id="vehicleSection" class="section">

        <h2>Add Vehicle</h2>

        <input
            type="number"
            id="vehicleId"
            placeholder="Vehicle ID"
        >

        <input
            type="text"
            id="vehicleName"
            placeholder="Vehicle Name"
        >

        <input
            type="text"
            id="vehicleType"
            placeholder="Vehicle Type (Car/Bike)"
        >

        <input
            type="number"
            id="vehiclePrice"
            placeholder="Price Per Day"
        >

        <button onclick="addVehicle()">
            Add Vehicle
        </button>

    </div>



    <!-- ================= ADD CUSTOMER ================= -->

    <div id="customerSection" class="section">

        <h2>Add Customer</h2>

        <input
            type="number"
            id="customerId"
            placeholder="Customer ID"
        >

        <input
            type="text"
            id="customerName"
            placeholder="Customer Name"
        >

        <input
            type="text"
            id="customerPhone"
            placeholder="Phone Number"
        >

        <button onclick="addCustomer()">
            Add Customer
        </button>

    </div>



    <!-- ================= AVAILABLE VEHICLES ================= -->

    <div id="displaySection" class="section">

        <h2>Available Vehicles</h2>

        <div id="vehicleList"></div>

    </div>



    <!-- ================= RENT VEHICLE ================= -->

    <div id="rentSection" class="section">

        <h2>Rent Vehicle</h2>

        <input
            type="number"
            id="rentCustomerId"
            placeholder="Customer ID"
        >

        <input
            type="number"
            id="rentVehicleId"
            placeholder="Vehicle ID"
        >

        <input
            type="number"
            id="rentDays"
            placeholder="Number of Days"
        >

        <button onclick="rentVehicle()">
            Rent Vehicle
        </button>

        <p id="rentResult"></p>

    </div>



    <!-- ================= RETURN VEHICLE ================= -->

    <div id="returnSection" class="section">

        <h2>Return Vehicle</h2>

        <input
            type="number"
            id="returnVehicleId"
            placeholder="Vehicle ID"
        >

        <button onclick="returnVehicle()">
            Return Vehicle
        </button>

        <p id="returnResult"></p>

    </div>



    <!-- ================= RENTAL HISTORY ================= -->

    <div id="historySection" class="section">

        <h2>Rental History</h2>

        <div id="historyList"></div>

    </div>



    <!-- ================= REVENUE ================= -->

    <div class="revenue">

        <h2>Total Revenue</h2>

        <p id="revenue">₹0</p>

    </div>


</div>



<script>


// =====================================================
// VARIABLES
// =====================================================


// Store all vehicles
let vehicles = [];


// Store all customers
let customers = [];


// Store rental history
let history = [];


// Store total revenue
let revenue = 0;



// =====================================================
// SHOW SECTION
// =====================================================

function showSection(sectionName) {

    let sections =
        document.getElementsByClassName("section");


    // Hide all sections

    for (let i = 0; i < sections.length; i++) {

        sections[i].style.display = "none";

    }


    // Show selected section

    document.getElementById(sectionName).style.display =
        "block";


    displayVehicles();

    displayHistory();
}



// =====================================================
// ADD VEHICLE
// =====================================================

function addVehicle() {


    let id =
        Number(document.getElementById("vehicleId").value);


    let name =
        document.getElementById("vehicleName").value;


    let type =
        document.getElementById("vehicleType").value;


    let price =
        Number(document.getElementById("vehiclePrice").value);



    // Create vehicle object

    let vehicle = {

        id: id,

        name: name,

        type: type,

        price: price,

        available: true

    };


    // Add vehicle to array

    vehicles.push(vehicle);


    alert("Vehicle added successfully!");


    // Clear input boxes

    document.getElementById("vehicleId").value = "";

    document.getElementById("vehicleName").value = "";

    document.getElementById("vehicleType").value = "";

    document.getElementById("vehiclePrice").value = "";


    displayVehicles();

}



// =====================================================
// DISPLAY VEHICLES
// =====================================================

function displayVehicles() {


    let list =
        document.getElementById("vehicleList");


    list.innerHTML = "";


    // Go through every vehicle

    for (let i = 0; i < vehicles.length; i++) {


        let vehicle = vehicles[i];


        // Display only available vehicles

        if (vehicle.available == true) {


            list.innerHTML +=

                "<div class='vehicle'>" +

                "<b>Vehicle ID:</b> "
                + vehicle.id +

                "<br>" +

                "<b>Name:</b> "
                + vehicle.name +

                "<br>" +

                "<b>Type:</b> "
                + vehicle.type +

                "<br>" +

                "<b>Price:</b> ₹"
                + vehicle.price
                + " per day" +

                "</div>";

        }

    }


    if (list.innerHTML == "") {

        list.innerHTML =
            "No vehicles available.";

    }

}



// =====================================================
// ADD CUSTOMER
// =====================================================

function addCustomer() {


    let id =
        Number(document.getElementById("customerId").value);


    let name =
        document.getElementById("customerName").value;


    let phone =
        document.getElementById("customerPhone").value;



    // Create customer object

    let customer = {

        id: id,

        name: name,

        phone: phone

    };


    // Add customer

    customers.push(customer);


    alert("Customer added successfully!");


    // Clear input boxes

    document.getElementById("customerId").value = "";

    document.getElementById("customerName").value = "";

    document.getElementById("customerPhone").value = "";

}



// =====================================================
// RENT VEHICLE
// =====================================================

function rentVehicle() {


    let customerId =
        Number(
            document.getElementById("rentCustomerId").value
        );


    let vehicleId =
        Number(
            document.getElementById("rentVehicleId").value
        );


    let days =
        Number(
            document.getElementById("rentDays").value
        );



    // Find customer

    let customer = null;


    for (let i = 0; i < customers.length; i++) {

        if (customers[i].id == customerId) {

            customer = customers[i];

        }

    }



    // Find vehicle

    let vehicle = null;


    for (let i = 0; i < vehicles.length; i++) {

        if (vehicles[i].id == vehicleId) {

            vehicle = vehicles[i];

        }

    }



    // Check customer

    if (customer == null) {

        document.getElementById("rentResult").innerHTML =
            "Customer not found!";

        return;

    }



    // Check vehicle

    if (vehicle == null) {

        document.getElementById("rentResult").innerHTML =
            "Vehicle not found!";

        return;

    }



    // Check availability

    if (vehicle.available == false) {

        document.getElementById("rentResult").innerHTML =
            "Vehicle is already rented!";

        return;

    }



    // Calculate cost

    let cost =
        vehicle.price * days;



    // Change vehicle status

    vehicle.available = false;



    // Add money to revenue

    revenue =
        revenue + cost;



    // Add rental to history

    history.push(

        customer.name
        + " rented "
        + vehicle.name
        + " for "
        + days
        + " days. Cost = ₹"
        + cost

    );



    // Show result

    document.getElementById("rentResult").innerHTML =

        "Vehicle rented successfully!<br>" +

        "Customer: "
        + customer.name
        + "<br>" +

        "Vehicle: "
        + vehicle.name
        + "<br>" +

        "Days: "
        + days
        + "<br>" +

        "Total Cost: ₹"
        + cost;



    // Update revenue

    document.getElementById("revenue").innerHTML =
        "₹" + revenue;



    // Update vehicle list

    displayVehicles();

}



// =====================================================
// RETURN VEHICLE
// =====================================================

function returnVehicle() {


    let id =
        Number(
            document.getElementById("returnVehicleId").value
        );



    // Find vehicle

    for (let i = 0; i < vehicles.length; i++) {


        if (vehicles[i].id == id) {


            // Check if already available

            if (vehicles[i].available == true) {

                document.getElementById("returnResult").innerHTML =
                    "Vehicle is already available!";

            }


            else {


                // Make vehicle available

                vehicles[i].available = true;


                document.getElementById("returnResult").innerHTML =
                    "Vehicle returned successfully!";

            }


            displayVehicles();

            return;

        }

    }



    document.getElementById("returnResult").innerHTML =
        "Vehicle not found!";

}



// =====================================================
// RENTAL HISTORY
// =====================================================

function displayHistory() {


    let list =
        document.getElementById("historyList");


    list.innerHTML = "";



    // Check history

    if (history.length == 0) {

        list.innerHTML =
            "No rental history available.";

        return;

    }



    // Display history

    for (let i = 0; i < history.length; i++) {


        list.innerHTML +=

            "<p>" +
            (i + 1) +
            ". " +
            history[i] +
            "</p>";

    }

}


</script>


</body>

</html>
